# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube al repositorio.

# --- Supabase (cuentas e informes guardados) -----------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Groq (agente de IA que redacta el informe) --------------------------
# https://console.groq.com/keys  · Solo se usa en el servidor.
GROQ_API_KEY=
# Opcional: modelos a usar (hay valores por defecto).
GROQ_MODEL=
GROQ_MODEL_FAST=

# Sin estas variables la app sigue funcionando:
# - sin Supabase, las cuentas y los informes se guardan solo en el dispositivo.
# - sin Groq, el informe se arma con la base de conocimiento documental propia.
